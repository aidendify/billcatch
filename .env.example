PORT=8080
DATABASE_PATH=/data/billcatch.db
UPLOAD_DIR=/data/uploads
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
PUBLIC_BASE_URL=http://localhost:8080

# Hours after completed_at before Unbilled alert. Verifier uses 0.
UNINVOICED_HOURS=48

CURRENCY=USD

FROM_NAME=
FROM_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset; Unbilled queue + Copy/CSV still work.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional Twilio SMS. Leave unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Unbilled office notify destinations (optional).
OWNER_NOTIFY_EMAIL=
OFFICE_EMAIL=
OFFICE_PHONE=

# Optional footer link labeled "Powered by BillCatch". Leave empty for no footer.
MARKETING_URL=
